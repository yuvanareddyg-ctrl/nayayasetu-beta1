# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Required to persist case data and login records. Without this, NyayaSetu runs
# in demonstration mode with in-memory sample data.
MONGODB_URI=mongodb://127.0.0.1:27017/nyayasetu

# ─── Admin authentication ──────────────────────────────────────────────────────
# Required to enable the /admin dashboard and the admin login API.
#
# ADMIN_JWT_SECRET  – at least 32 random characters (used to sign session tokens)
#   Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ADMIN_PASSWORD_HASH – bcrypt hash of your chosen admin password (cost 12)
#   Generate with: node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
#
ADMIN_JWT_SECRET=change_me_use_a_long_random_string_at_least_32_chars
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_THIS_WITH_A_REAL_BCRYPT_HASH
